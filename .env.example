# Provedor de IA Gratuitos: "gemini" ou "ollama"\nLLM_PROVIDER=gemini\nGEMINI_API_KEY=sua_chave_gemini_aqui\n\n# Configurações do Ollama (caso use IA Local)\nOLLAMA_HOST=http://localhost:11434\nOLLAMA_MODEL=llama3:latest\n\n# Dados do Candidato\nCANDIDATE_NAME=Nome Completo\nCANDIDATE_EMAIL=seu@email.com\nCANDIDATE_PHONE=(11) 99999-9999\nCANDIDATE_LOCATION=São Paulo, SP, Brasil\nCANDIDATE_LINKEDIN=https://linkedin.com/in/seu-perfil\nCANDIDATE_GITHUB=https://github.com/seu-perfil\n\n# Configuração SMTP para envio por E-mail\nSMTP_HOST=smtp.gmail.com\nSMTP_PORT=587\nSMTP_USER=seu_email@gmail.com\nSMTP_PASS=sua_senha_de_aplicativo\n\n# Credenciais do LinkedIn (opcional para Easy Apply)\nLINKEDIN_EMAIL=contato@email.com\nLINKEDIN_PASSWORD=sua_senha_linkedin\n\n# Credenciais da Gupy (opcional para preenchimento)\nGUPY_EMAIL=contato@email.com\nGUPY_PASSWORD=sua_senha_gupy