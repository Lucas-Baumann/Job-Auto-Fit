# Provedor de IA: gemini|ollama|openai|claude|groq|openrouter|custom
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui
# "-latest" segue a versão estável mais recente automaticamente. Se der 404, veja o nome atual
# em ai.google.dev/gemini-api/docs/models e troque aqui.
GEMINI_MODEL=gemini-flash-latest

# OpenRouter (free tier) - https://openrouter.ai/keys - modelos :free (ver lista atual em openrouter.ai/models?max_price=0 - digite manualmente o slug)
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# OpenAI / Claude / Groq (pagos)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=

# Custom OpenAI-compatível
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=

# Configurações do Ollama (caso use IA Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Dados do Candidato
CANDIDATE_NAME=Nome Completo
CANDIDATE_EMAIL=seu@email.com
CANDIDATE_PHONE=(11) 99999-9999
CANDIDATE_LOCATION=São Paulo, SP, Brasil
CANDIDATE_LINKEDIN=https://linkedin.com/in/seu-perfil
CANDIDATE_GITHUB=https://github.com/seu-perfil

# Configuração SMTP para envio por E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo

# LinkedIn e Gupy NÃO usam mais email/senha aqui no .env — o login (opcional, pra Easy Apply
# + posts de recrutadores) é feito uma vez por navegador real, direto pela aba
# "IA & Conexões" do app (botão "Fazer login"). Só a sessão fica salva localmente, nunca a
# senha.

# GitHub Token para push direto de READMEs (perfil + repos) - github.com/settings/tokens classic com scope repo
GITHUB_TOKEN=seu_token_github_aqui
