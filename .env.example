# Provedor de IA: gemini|ollama|openai|claude|groq|openrouter|custom
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# OpenRouter (free tier) - https://openrouter.ai/keys - modelos :free
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenAI / Claude / Groq (pagos)
OPENAI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=

# Custom OpenAI-compatível
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=

# Configurações do Ollama (caso use IA Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Dados do Candidato
CANDIDATE_NAME=Nome Completo
CANDIDATE_EMAIL=seu@email.com
CANDIDATE_PHONE=(11) 99999-9999
CANDIDATE_LOCATION=São Paulo, SP, Brasil
CANDIDATE_LINKEDIN=https://linkedin.com/in/seu-perfil
CANDIDATE_GITHUB=https://github.com/seu-perfil

# Configuração SMTP para envio por E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo

# Credenciais do LinkedIn (opcional para Easy Apply + posts)
LINKEDIN_EMAIL=contato@email.com
LINKEDIN_PASSWORD=sua_senha_linkedin

# Credenciais da Gupy (opcional para preenchimento)
GUPY_EMAIL=contato@email.com
GUPY_PASSWORD=sua_senha_gupy
