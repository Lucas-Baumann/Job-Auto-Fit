# Provedor de IA Gratuitos: "gemini" ou "ollama"
LLM_PROVIDER=gemini
GEMINI_API_KEY=sua_chave_gemini_aqui

# Configurações do Ollama (caso use IA Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Dados do Candidato
CANDIDATE_NAME=Seu Nome Completo
CANDIDATE_EMAIL=seu_email@gmail.com
CANDIDATE_PHONE=(11) 99999-9999
CANDIDATE_LOCATION=São Paulo, SP, Brasil
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/seu-perfil
CANDIDATE_GITHUB=https://github.com/seu-perfil

# Configuração SMTP para envio por E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo

# Credenciais do LinkedIn (opcional para Easy Apply)
LINKEDIN_EMAIL=seu_email_linkedin@gmail.com
LINKEDIN_PASSWORD=sua_senha_linkedin

# Credenciais da Gupy (opcional para preenchimento)
GUPY_EMAIL=seu_email_gupy@gmail.com
GUPY_PASSWORD=sua_senha_gupy
